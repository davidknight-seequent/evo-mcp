{
	"servers": {
		"evo-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": ["--from", "c:\\Dev\\evo-mcp", "evo-mcp"],
			"env": {
				"MCP_TRANSPORT": "stdio",
				"AUTH_METHOD": "native_app",
				"EVO_CLIENT_ID": "your-client-id",
				"EVO_REDIRECT_URL": "http://localhost:3000/signin-callback",
				"MCP_TOOL_FILTER": "all"
			}
		}
	}
}
